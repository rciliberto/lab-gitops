{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 0,
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yml$/",
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates. There is no CI in this repo, so don't wait for status checks.",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Pre-1.0 patch updates are safe to automerge, but pre-1.0 minor bumps can break, so they stay as PRs.",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Longhorn only supports upgrading one minor version at a time, so propose each minor separately.",
      "matchPackageNames": ["longhorn"],
      "separateMultipleMinor": true
    },
    {
      "description": "Cilium is the CNI; a bad upgrade takes down all pod networking, so review bumps by hand.",
      "matchPackageNames": ["cilium"],
      "automerge": false
    },
    {
      "description": "Gateway API CRDs must match what Cilium supports, so review bumps by hand.",
      "matchPackageNames": ["kubernetes-sigs/gateway-api"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Gateway API CRDs are installed from the upstream release bundle.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apps/core/gateway-api/kustomization\\.yaml$/"],
      "matchStrings": ["https://github\\.com/kubernetes-sigs/gateway-api/releases/download/(?<currentValue>v[^/]+)/"],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases"
    }
  ]
}
